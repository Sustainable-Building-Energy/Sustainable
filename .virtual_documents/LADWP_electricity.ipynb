import math
import pandas as pd

# ==========================================================================
# 1) LOAD MONTHLY SHORTFALL DATA
#    (ladwp_monthly_merged_with_differences.csv)
# ==========================================================================
df_monthly = pd.read_csv(
    "ladwp_monthly_merged_with_differences.csv",
    parse_dates=["Date"],  # or adjust if needed
    index_col="Date"
)

# Column for shortfall is 'diff_demand_minus_renewable'
column_gap = "diff_demand_minus_renewable"
if column_gap not in df_monthly.columns:
    raise ValueError(f"Column '{column_gap}' not found in df_monthly.")

# Find the peak month (largest shortfall)
max_gap = df_monthly[column_gap].max()
peak_month_date = df_monthly[column_gap].idxmax()
peak_month_name = peak_month_date.strftime("%B")  # e.g. "January", "July"

print(f"Peak shortfall: {max_gap:,.0f} MWh in {peak_month_date.date()} ({peak_month_name})\n")


# ==========================================================================
# 2) LOAD SOLAR DATA (ONE 16-PANEL ARRAY)

# ==========================================================================
solar_data = {
    "Datetime": [
        "2022-01-31","2022-02-28","2022-03-31","2022-04-30",
        "2022-05-31","2022-06-30","2022-07-31","2022-08-31",
        "2022-09-30","2022-10-31","2022-11-30","2022-12-31"
    ],
    "PV_W_e": [
        616332.013115, 676367.789853, 762570.817908, 793970.903427,
        795071.038226, 714764.559756, 673450.911688, 667376.286098,
        669135.054581, 699004.280347, 633054.255750, 514776.310892
    ],
}
month_list = [
    "January","February","March","April","May","June",
    "July","August","September","October","November","December"
]

df_solar = pd.DataFrame(solar_data)
df_solar["Month"] = month_list
# Convert from Wh to MWh
df_solar["PV_MWh_per_16_panels"] = df_solar["PV_W_e"] / 1e6
df_solar.set_index("Month", inplace=True)

# Production in peak month (for 16 panels)
try:
    solar_prod_mwh_for_16_panels = df_solar.loc[peak_month_name, "PV_MWh_per_16_panels"]
except KeyError:
    raise KeyError(f"Month '{peak_month_name}' not found in df_solar DataFrame.")

# Calculate area per panel:
AREA_PER_16_PANELS = 26.556  # m²
AREA_PER_PANEL = AREA_PER_16_PANELS / 16.0

# ==========================================================================
# 3) LOAD WIND DATA (ONE TURBINE)
#    We'll note monthly MWh for a single turbine
# ==========================================================================
wind_data = {
    "Month": [
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"
    ],
    "Energy_MWh": [
        665.20, 850.72, 575.26, 723.09, 683.26, 618.72,
        1152.71, 1006.48, 1216.58, 896.14, 626.93, 819.56
    ]
}
df_wind = pd.DataFrame(wind_data)
df_wind.set_index("Month", inplace=True)

try:
    wind_prod_mwh_for_1_turbine = df_wind.loc[peak_month_name, "Energy_MWh"]
except KeyError:
    raise KeyError(f"Month '{peak_month_name}' not found in df_wind DataFrame.")

print(f"In {peak_month_name}, 16 panels produce ~{solar_prod_mwh_for_16_panels:.2f} MWh, "
      f"1 turbine ~{wind_prod_mwh_for_1_turbine:.2f} MWh.")


# ==========================================================================
# 4) GENERATE ALL COMBOS: from 0% solar / 100% wind to 100% solar / 0% wind
#    in 1% increments
# ==========================================================================
results = []

for solar_percent in range(101):  # 0..100 inclusive
    wind_percent = 100 - solar_percent
    
    # MWh needed from solar
    solar_mwh_needed = (solar_percent / 100.0) * max_gap
    # MWh needed from wind
    wind_mwh_needed  = (wind_percent / 100.0) * max_gap
    
    # Number of panels required
    # First, how many 16-panel "blocks" are needed?
    # If each block (16 panels) in peak month yields solar_prod_mwh_for_16_panels:
    if solar_prod_mwh_for_16_panels > 0:
        num_16panel_blocks = math.ceil(solar_mwh_needed / solar_prod_mwh_for_16_panels)
    else:
        num_16panel_blocks = 0
    
    # Now, total number of panels is 16 * that
    num_solar_panels = 16 * num_16panel_blocks
    
    # Total area for that many panels
    area_solar_m2 = num_solar_panels * AREA_PER_PANEL
    
    # Number of turbines required
    if wind_prod_mwh_for_1_turbine > 0:
        num_turbines = math.ceil(wind_mwh_needed / wind_prod_mwh_for_1_turbine)
    else:
        num_turbines = 0
    
    results.append({
        "Solar_%": solar_percent,
        "Wind_%": wind_percent,
        "Num_Solar_Panels": num_solar_panels,
        "Area_Solar_m2": area_solar_m2,
        "Num_Turbines": num_turbines
    })

df_combos = pd.DataFrame(results)

# --------------------------------------------------------------------------
# 5) Show final table
# --------------------------------------------------------------------------
print("\nPossible Splits to Cover the Peak Month Shortfall:")
display(df_combos)

df_combos.to_csv("wind_solar_combinations_by_panel.csv", index=False)






