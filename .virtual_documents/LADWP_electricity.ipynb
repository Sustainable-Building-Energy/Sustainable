import pandas as pd

# -----------------------------------------------------
# STEP A: Read region data (Hourly)
# -----------------------------------------------------

df_region = pd.read_csv("ladwp_hourly_region_data_FULL.csv")


#   Date, D, DF, NG, TI, ...
# Rename "NG" to "NetGen" to be explicit
df_region.rename(columns={"NG": "NetGen"}, inplace=True)

# Convert date column to datetime
df_region["Date"] = pd.to_datetime(df_region["Date"])

# -----------------------------------------------------
# STEP B: Read fuel-type data (Hourly)
# -----------------------------------------------------

df_fuel = pd.read_csv("ladwp_hourly_fueltype_data_FULL.csv")


# But "NG" here = Natural Gas. Rename it to avoid confusion.
df_fuel.rename(columns={"NG": "NatGas"}, inplace=True)

df_fuel["Date"] = pd.to_datetime(df_fuel["Date"])

# -----------------------------------------------------
# STEP C: Merge region + fuel-type data
# -----------------------------------------------------
# We'll do an outer merge so we keep all timestamps from both tables.
df_merged = pd.merge(df_region, df_fuel, how="outer", on="Date")

# After merging, df_merged has columns:
#   Date, D, DF, NetGen, TI, COL, NatGas, OTH, SUN, WAT, WND, ...

# -----------------------------------------------------
# STEP D: Compute the requested differences
# -----------------------------------------------------

# 1) Hourly difference between Demand - Net Generation
df_merged["diff_demand_minus_netgen"] = df_merged["D"] - df_merged["NetGen"]

# 2) Demand - non-renewable generation
#    Non-renewable = COL + NatGas + OTH
df_merged["non_renewable"] = df_merged["COL"] + df_merged["NatGas"] + df_merged["OTH"]
df_merged["diff_demand_minus_nonrenewable"] = df_merged["D"] - df_merged["non_renewable"]

# 3) Demand - renewable generation
#    Renewable = SUN + WAT + WND
df_merged["renewable"] = df_merged["SUN"] + df_merged["WAT"] + df_merged["WND"]
df_merged["diff_demand_minus_renewable"] = df_merged["D"] - df_merged["renewable"]

# -----------------------------------------------------
# STEP E: Inspect or export the final results
# -----------------------------------------------------
print(df_merged[[
    "Date", 
    "D", 
    "NetGen", 
    "COL", "NatGas", "OTH", "SUN", "WAT", "WND",
    "diff_demand_minus_netgen",
    "diff_demand_minus_nonrenewable",
    "diff_demand_minus_renewable"
]].head(20))

# Save to CSV for further analysis
df_merged.to_csv("ladwp_hourly_merged_with_differences.csv", index=False)



df_merged


